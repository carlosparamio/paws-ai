# OpenRouter configuration for AI-powered interpretation
# Get your key at https://openrouter.ai/keys
AI_PARSER_API_KEY=your_api_key_here

# OpenAI-compatible endpoint. OpenRouter is used by default.
AI_PARSER_ENDPOINT=https://openrouter.ai/api/v1

# Model to use. Required when --parser-mode ai is enabled.
# Examples:
# - google/gemini-2.0-flash-001 (fast and reliable)
# - google/gemini-2.0-flash-lite-preview-02-05:free (free)
# - openrouter/auto (automatic OpenRouter selection)
AI_PARSER_MODEL=google/gemini-2.0-flash-lite-001

# AI image generation configuration for bin/web --graphics-mode ai-*.
# All settings in this section are required when an AI graphics mode is enabled
# and --graphics-cache is not being used.
# Providers:
# - openai: uses the Image Edits endpoint and sends the canonical PAWS render as
#   a reference image.
# - openrouter: uses this base URL and appends /chat/completions internally.
AI_GRAPHICS_PROVIDER=openai
AI_GRAPHICS_API_KEY=your_openai_or_openrouter_api_key_here
AI_GRAPHICS_ENDPOINT=https://api.openai.com/v1/images/edits
AI_GRAPHICS_MODEL=gpt-image-2

# OpenRouter example:
# AI_GRAPHICS_PROVIDER=openrouter
# AI_GRAPHICS_ENDPOINT=https://openrouter.ai/api/v1
# AI_GRAPHICS_MODEL=google/gemini-2.5-flash-image
# AI_GRAPHICS_MAX_TOKENS=2048
# Optional OpenRouter image resolution hint, when supported by the selected model:
# AI_GRAPHICS_IMAGE_SIZE=2K
#
# Observed OpenRouter image model tradeoffs for PAWS graphics:
# - google/gemini-2.5-flash-image: very fast; acceptable for interactive use,
#   though quality varies by scene.
# - openai/gpt-5-image-mini: strong quality/speed balance; good candidate for
#   pregeneration, but may ignore requested aspect ratio and require padding.
# - openai/gpt-5.4-image-2: best observed quality; very slow and expensive, best
#   reserved for special games or offline pregeneration.
# - recraft/recraft-v4.1: not recommended so far; tends to preserve the original
#   Spectrum bitmap too literally.
# - black-forest-labs/flux.2-klein-4b: not recommended so far; tends to invent a
#   new scene instead of preserving PAWS composition.
# Avoid *-vector models for now because the web cache route stores raster JPEGs.
